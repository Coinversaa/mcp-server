{
    "name": "@coinversaa/mcp-server",
    "version": "0.6.0",
    "description": "Coinversa Pulse — Crypto intelligence MCP server for AI agents. 42 tools covering Hyperliquid trader analytics, syncer-backed risk routes, cohort intelligence, live market data, builder dex markets, canonical cross-market asset taxonomy (PAXG↔GOLD), and more.",
    "type": "module",
    "bin": {
        "coinversaa-mcp": "./build/index.js"
    },
    "files": [
        "build"
    ],
    "scripts": {
        "build": "tsc && chmod 755 build/index.js",
        "dev": "node --loader ts-node/esm src/index.ts",
        "prepare": "npm run build"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.12.1",
        "@toon-format/toon": "^2.1.0",
        "zod": "^3.24.0"
    },
    "devDependencies": {
        "@types/node": "^20.11.24",
        "ts-node": "^10.9.2",
        "typescript": "^5.3.3"
    },
    "keywords": [
        "mcp",
        "crypto",
        "hyperliquid",
        "trading",
        "intelligence",
        "ai-agent",
        "coinversaa",
        "model-context-protocol",
        "claude",
        "cursor"
    ],
    "author": "Coinversa <hello@coinversaa.ai> (https://coinversa.ai)",
    "homepage": "https://github.com/coinversaa/mcp-server#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/coinversaa/mcp-server.git"
    },
    "bugs": {
        "url": "https://github.com/coinversaa/mcp-server/issues"
    },
    "license": "MIT",
    "mcpName": "io.github.Coinversaa/mcp-server",
    "openclaw": {
        "extensions": [
            "./build/index.js"
        ]
    }
}
